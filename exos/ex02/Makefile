remove_garbage:
	rm -rf srcs/garbage*

clean: remove_garbage
	@echo "Check in srcs if every garbagesX are deleted. make restore to restore the session"

restore:
	touch srcs/garbage1
	touch srcs/garbage2
	touch srcs/garbage3
	touch srcs/garbage4
	touch srcs/garbage5
	touch srcs/garbage6
	touch srcs/garbage7